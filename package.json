{
  "name": "dnd-grimoire",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"ng serve\" \"tsx watch server/index.ts\"",
    "dev:front": "ng serve",
    "dev:server": "tsx watch server/index.ts",
    "prebuild": "node scripts/set-env.js",
    "build": "ng build",
    "build:api": "esbuild api/_entry.ts --bundle --platform=node --format=esm --outfile=api/index.mjs --packages=external",
    "test": "ng test",
    "server": "tsx server/index.ts",
    "notion:setup": "tsx server/scripts/setup.ts",
    "notion:setup:demo": "tsx server/scripts/setup.ts --with-sample-data"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@notionhq/client": "^5.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "cors": "^2.8.6",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.4",
    "esbuild": "^0.27.3",
    "express": "^5.2.1",
    "mathjs": "^15.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0"
  }
}
