# Notion (optionnel — pour le backup/sync Notion)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxx
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxx

# Supabase — obligatoire pour le cloud sync
# Récupérer depuis: supabase.com → ton projet → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Mot de passe DB PostgreSQL (pour migrations directes uniquement)
SUPABASE_DB_PASSWORD=your_db_password
